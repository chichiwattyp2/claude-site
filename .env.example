# Environment Variables Example
# Copy this file to .env.local and fill in your values

# Optional: For integrating real AI chat (Claude or OpenAI)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Optional: Sentry error tracking
# SENTRY_DSN=your_sentry_dsn

# Admin Dashboard Configuration
# Set a strong password for admin access
ADMIN_PASSWORD=changeme123
# Secret key for session encryption (generate with: openssl rand -base64 32)
SESSION_SECRET=your-secret-key-here-change-this-in-production
